# Optional AI provider (never commit real keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SEC=45
AI_PROMPT_VERSION=triage-v2

# Optional anomaly detector overrides
ANOMALY_POLL_INTERVAL_SEC=15
ANOMALY_BASELINE_WINDOW=30m
# Seconds between baseline end and observation (keeps drift out of its own baseline)
ANOMALY_BASELINE_GUARD_SEC=60
ANOMALY_MIN_SAMPLES=20
ANOMALY_PERSIST_COUNT=3
ANOMALY_RECOVER_COUNT=2
